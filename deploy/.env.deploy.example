# Скопируйте в deploy/.env.deploy (файл в .gitignore — не коммитить).
# Используется скриптом deploy/sync-to-production.sh

# SSH: пользователь и хост (как в ssh user@example.com)
# Пример: deploy@203.0.113.10 или deploy@server.example.com
DEPLOY_SSH_TARGET=user@ssh.example.com

# Необязательно: полный путь к ssh (в Git Bash под Windows с кириллицей в профиле скрипт сам берёт OpenSSH из Windows).
# DEPLOY_SSH_BIN=/c/WINDOWS/System32/OpenSSH/ssh.exe

# Абсолютный путь к корню репозитория на сервере (где лежат backend/, frontend/, .git)
DEPLOY_APP_PATH=/var/www/kasatkin_da/data/www/fabrika-tentov.ru

# Ветка для git pull
DEPLOY_GIT_BRANCH=main

# Имя git-remote на сервере (по умолчанию origin). Часто на VPS origin = зеркало
# konstmax1388/Fabric_Awinings_release, а вы пушите только в konstmax1388/Fabric_Awinings:
# тогда на сервер не приезжают коммиты и в админке бейдж остаётся на старой VERSION (например 3.2.20).
# Решение: после релиза выполнить `.\deploy\push-mirror.ps1` (или `git push release main`).
# Проверка на сервере: cd DEPLOY_APP_PATH && git remote -v && cat VERSION && git log -1
# DEPLOY_GIT_REMOTE=origin

# Имя systemd-сервиса Gunicorn (как в /etc/systemd/system/…). Пусто — без перезапуска.
DEPLOY_SYSTEMD_SERVICE=fabrika-gunicorn

# Чтобы деплой мог делать sudo systemctl restart без пароля, на сервере под root настройте sudoers:
#   см. deploy/sudoers/fabrika-gunicorn-restart.example
# Проверка от пользователя деплоя: sudo -n systemctl restart fabrika-gunicorn
#
# Если sudoers ещё не настроен — временно:
# DEPLOY_SKIP_SYSTEMD=1
#
# Перед SSH-деплоем прогнать локально те же проверки, что GitHub CI (долго, но ловит поломки до выкладки):
# DEPLOY_RUN_PREFLIGHT=1
